# Nilai di bawah sudah siap untuk Firebase Emulator lokal (project "demo-panggung").
# Untuk produksi, ganti dengan config Web App dari Firebase Console > Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-panggung.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-panggung
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app

# 1 = pakai Firebase Emulator lokal (npm run emulators); 0 = Firebase asli
NEXT_PUBLIC_USE_EMULATOR=1

# Service account untuk server (kosongkan saat memakai emulator).
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Rahasia untuk tanda tangan QR tiket. Di produksi pakai string acak panjang.
TICKET_QR_SECRET=dev-secret-panggung-lokal

NEXT_PUBLIC_SITE_URL=http://localhost:3000
